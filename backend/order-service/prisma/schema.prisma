generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  status     String   @default("PLACED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

